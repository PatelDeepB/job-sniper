{
  "name": "job-sniper-extension",
  "version": "0.2.3",
  "type": "module",
  "description": "Chrome Extension for JobSniper: 1-click human-paced ATS autofill, real-time job alerts, multi-LLM engine, and recruiter outreach.",
  "scripts": {
    "build": "tsc && node scripts/build_extension.js",
    "package": "npm run build && python scripts/package_extension.py",
    "watch": "tsc --watch",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "chrome-extension",
    "job-search",
    "ai-agent",
    "ats-autofill",
    "greenhouse",
    "lever",
    "gemini",
    "claude",
    "nvidia",
    "groq"
  ],
  "author": "Deep Patel",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.4.5"
  }
}
