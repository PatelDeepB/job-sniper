{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./extension/dist",
    "rootDir": "./extension/src",
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "include": ["extension/src/**/*"]
}
